# Copy to .env and fill in from your browser session (x.com, logged in):
# DevTools > Application > Cookies > x.com
AUTH_TOKEN=
CT0=

# Optional overrides — only set these if the tool errors out saying they're stale.
# BEARER=
# QUERY_ID=
# USER_TIMELINE_QUERY_ID=

# CLIENT_TRANSACTION_ID is no longer needed — the CLI computes a fresh one
# per request automatically (it goes stale within seconds if hardcoded).
